# Copy this to ~/.env on the server and fill in real values.
# CI/CD sets APP_IMAGE automatically — you only need to set it manually for the first boot.

POSTGRES_USER=cotales
POSTGRES_PASSWORD=change-me-strong-password
JWT_SECRET=change-me-minimum-32-characters-long-secret-key
APP_IMAGE=YOUR_ACCOUNT_ID.dkr.ecr.YOUR_REGION.amazonaws.com/cotales-api:latest
